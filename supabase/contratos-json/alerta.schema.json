{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://foundersbs.com/schemas/alerta.json",
  "title": "Alertas detectadas en una sesión",
  "description": "Salida del Motor 4B. Sin cita textual no hay alerta: sin cita es una interpretación y se discute, con cita es un hecho y se trabaja.",
  "type": "object",
  "additionalProperties": false,
  "required": ["sesion_id", "alertas", "senales_sesion", "observaciones"],
  "properties": {
    "sesion_id": { "type": "string" },
    "alertas": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["codigo", "estado_semaforo", "titulo", "cuerpo", "cita_textual", "pedido"],
        "properties": {
          "codigo": {
            "type": "string",
            "pattern": "^CT-(N[1-4]|R[1-6]|A[1-6]|B[1-5]|C[1-3])$",
            "description": "Solo códigos existentes. Si algo preocupa y no encaja, va en observaciones."
          },
          "estado_semaforo": { "type": "string", "enum": ["amarillo", "rojo", "negro"] },
          "titulo": { "type": "string", "maxLength": 90 },
          "cuerpo": {
            "type": "string",
            "minLength": 60,
            "description": "Las 3 líneas: qué pasa, la cita, con qué se relaciona."
          },
          "cita_textual": {
            "type": "string",
            "minLength": 5,
            "description": "Literal, sin corregir la gramática. Para criterios de ausencia (familia B), la constatación de qué se buscó y no apareció."
          },
          "fecha_cita": { "type": "string", "format": "date" },
          "pedido": {
            "type": "string",
            "minLength": 20,
            "description": "Qué se espera, de quién, y qué pasa si vuelve a aparecer."
          },
          "vez_numero": { "type": ["integer", "null"], "minimum": 1, "description": "Cuántas veces apareció este código en los últimos 60 días" },
          "se_relaciona_con": {
            "type": ["object", "null"],
            "additionalProperties": false,
            "properties": {
              "alerta_id": { "type": ["string", "null"] },
              "fecha": { "type": ["string", "null"], "format": "date" },
              "detalle": { "type": "string" }
            }
          },
          "destinatario_sugerido": { "type": "string", "enum": ["consultora", "revision_externa", "admin"] },
          "prioridad": { "type": "integer", "minimum": 1, "maximum": 100 }
        }
      }
    },
    "senales_sesion": {
      "description": "Familia B, como campos y no como prosa. Las ausencias también son señal.",
      "type": "object",
      "additionalProperties": false,
      "required": ["menciono_numeros", "se_fue_en_herramienta", "cerro_con_compromiso", "abrio_repasando", "pct_habla_cliente"],
      "properties": {
        "menciono_numeros": { "type": "boolean" },
        "se_fue_en_herramienta": { "type": "boolean" },
        "cerro_con_compromiso": { "type": "boolean" },
        "abrio_repasando": { "type": "boolean" },
        "pct_habla_cliente": { "type": "integer", "minimum": 0, "maximum": 100 },
        "tema_declarado": { "type": ["string", "null"] },
        "tema_tratado": { "type": ["string", "null"] }
      }
    },
    "observaciones": {
      "description": "Lo que preocupa y no encaja en ningún criterio. Sin estado de semáforo. Esta lista se revisa cada tanto para decidir si hace falta un criterio nuevo.",
      "type": "array",
      "items": { "type": "string" }
    },
    "descartadas": {
      "description": "Señales que el modelo consideró y descartó, con el motivo. Útil para calibrar y para auditar falsos negativos.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["cita", "motivo_descarte"],
        "properties": {
          "cita": { "type": "string" },
          "motivo_descarte": {
            "type": "string",
            "enum": [
              "queja_aislada_resuelta_en_sesion",
              "duda_tecnica",
              "mal_dia_o_tema_personal",
              "emocion_con_avance",
              "cliente_nuevo_sin_linea_base"
            ]
          }
        }
      }
    }
  }
}
