{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://foundersbs.com/schemas/diagnostico.json",
  "title": "Diagnóstico de caso",
  "description": "Salida del Motor 1. El protocolo de 10 pasos. cuello_botella es un string y no un array a propósito: si el modelo devuelve dos, es un fallo de validación, no una respuesta más completa.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "diagnostico", "cuello_botella", "tipo_bloqueo", "eslabon_roto",
    "evidencia", "que_no_haria", "hipotesis_principal", "plan_accion",
    "metricas", "checkpoint", "criterio_decision", "preguntas_abiertas",
    "principio_founders", "por_que"
  ],
  "properties": {
    "diagnostico": {
      "description": "Paso 1. Qué está sucediendo realmente en el negocio.",
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "items": { "type": "string", "minLength": 20 }
    },
    "cuello_botella": {
      "description": "Paso 2. UNO. Escalar a propósito.",
      "type": "string",
      "minLength": 30
    },
    "tipo_bloqueo": {
      "type": "string",
      "enum": ["estrategico", "mensaje", "adquisicion", "comercial", "entrega", "operativo", "ejecucion", "emocional"]
    },
    "eslabon_roto": {
      "description": "Primer eslabón de la cadena donde algo no cierra. No el más visible.",
      "type": "string",
      "enum": ["cliente", "problema", "deseo", "oferta", "promesa", "mensaje", "canal", "lead", "setting", "venta", "entrega", "resultado"]
    },
    "evidencia": {
      "description": "Paso 3. Hechos separados de hipótesis. Un hecho sin fuente no es un hecho.",
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["afirmacion", "tipo"],
        "properties": {
          "afirmacion": { "type": "string", "minLength": 10 },
          "tipo": { "type": "string", "enum": ["hecho", "hipotesis"] },
          "fuente_tipo": { "type": "string", "enum": ["sesion", "metricas", "onboarding", "pago", "estrategia", "alerta", "material"] },
          "fuente_id": { "type": ["string", "null"] },
          "fecha": { "type": ["string", "null"], "format": "date" },
          "cita": { "type": ["string", "null"] },
          "muestra": {
            "description": "Sobre cuántos casos se apoya. Obligatorio si la afirmación es sobre qué funciona o no funciona.",
            "type": ["string", "null"]
          }
        },
        "allOf": [
          {
            "if": { "properties": { "tipo": { "const": "hecho" } } },
            "then": { "required": ["fuente_tipo", "fuente_id", "fecha"] }
          }
        ]
      }
    },
    "que_no_haria": {
      "description": "Paso 4. Obligatorio: es la sección que más criterio transfiere.",
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["accion", "por_que"],
        "properties": {
          "accion": { "type": "string" },
          "por_que": { "type": "string" }
        }
      }
    },
    "hipotesis_principal": { "type": "string", "minLength": 30 },
    "plan_accion": {
      "description": "Paso 6. Máximo 5. Ordenadas.",
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["orden", "accion", "responsable"],
        "properties": {
          "orden": { "type": "integer", "minimum": 1 },
          "accion": { "type": "string", "minLength": 15 },
          "responsable": { "type": "string", "enum": ["cliente", "consultora", "setter", "closer", "community_manager", "agencia", "socio", "equipo_delivery"] },
          "vencimiento_dias": { "type": ["integer", "null"], "minimum": 1 }
        }
      }
    },
    "metricas": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["metrica"],
        "properties": {
          "metrica": { "type": "string" },
          "valor_actual": { "type": ["string", "number", "null"] },
          "valor_objetivo": { "type": ["string", "number", "null"] }
        }
      }
    },
    "checkpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fecha", "que_revisamos"],
      "properties": {
        "fecha": { "type": "string", "format": "date" },
        "que_revisamos": { "type": "string" }
      }
    },
    "criterio_decision": {
      "description": "Paso 9. Con números, no con adjetivos. Nunca un experimento sin criterio de evaluación.",
      "type": "object",
      "additionalProperties": false,
      "required": ["continuar_si", "corregir_si", "replantear_si"],
      "properties": {
        "continuar_si": { "type": "string", "minLength": 10 },
        "corregir_si": { "type": "string", "minLength": 10 },
        "replantear_si": { "type": "string", "minLength": 10 }
      }
    },
    "preguntas_abiertas": {
      "description": "Paso 10. Lo que no está en el expediente va acá, nunca inventado en la evidencia.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["pregunta"],
        "properties": {
          "pregunta": { "type": "string" },
          "para_que_sirve": { "type": ["string", "null"] },
          "conseguir_en": { "type": ["string", "null"], "description": "Sesión, planilla o persona donde obtenerla" }
        }
      }
    },
    "precedentes_citados": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["caso", "patron"],
        "properties": {
          "caso": { "type": "string" },
          "patron": { "type": "string" },
          "que_paso_ahi": { "type": "string" }
        }
      }
    },
    "principio_founders": {
      "description": "Regla generalizable detrás de la decisión, para que la consultora reconozca el patrón sola.",
      "type": "string",
      "minLength": 30
    },
    "por_que": {
      "description": "Una línea: estoy llegando a esta conclusión porque…",
      "type": "string",
      "minLength": 20
    },
    "contradiccion_con_consultora": {
      "description": "Se completa solo si el diagnóstico contradice la lectura de la consultora. Contradecir es obligatorio cuando el expediente no la respalda.",
      "type": ["string", "null"]
    }
  }
}
