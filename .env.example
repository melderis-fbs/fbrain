# Copiar a .env.local y completar. Nada de esto es obligatorio para arrancar:
# sin ninguna variable Brain corre en modo demostración con 85 clientes
# ficticios, y sin la key de modelo los motores quedan "sin conectar" y
# responde el motor de reglas local.

# --- Base de datos ---------------------------------------------------------
# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Forzar el modo demostración aunque haya credenciales cargadas.
# Dejar vacío para usar Supabase. Valor admitido: demo
NEXT_PUBLIC_MODO_DATOS=

# --- Modelos ---------------------------------------------------------------
# NUNCA con prefijo NEXT_PUBLIC_: esta key no puede cruzar al browser.
ANTHROPIC_API_KEY=

# Opcionales. Por defecto los dos usan claude-opus-5.
# MODELO_CRITERIO   → diagnóstico, coherencia, onboarding, score y el chat
# MODELO_EXTRACCION → extractor de transcripciones y de ficha
#
# Si la extracción se siente lenta, acá está la palanca más grande:
# MODELO_EXTRACCION=claude-sonnet-5 responde bastante más rápido y sale 2,5
# veces más barato. Extraer es copiar lo que dice el documento y dejar vacío lo
# que no dice; el criterio del método —diagnóstico, coherencia— se queda en
# Opus, que es donde la diferencia se nota. Es una variable de entorno: se
# cambia, se compara con dos o tres clientes y se vuelve atrás si no convence.
MODELO_CRITERIO=
MODELO_EXTRACCION=

# Cuántas veces se le devuelve el error de validación al modelo antes de
# declarar el fallo. El contrato del paquete dice 3.
MAX_REINTENTOS_VALIDACION=3

# --- La planilla consolidada ----------------------------------------------
# El ID del enlace de Drive: el pedazo entre /d/ y /edit.
# La planilla tiene que estar compartida como "cualquiera con el enlace puede
# ver". No hace falta service account: se lee por el export CSV.
SHEETS_PLANILLA_ID=

# Nombres de las solapas, sólo si no usás los que vienen por defecto. Los
# defaults ya apuntan a "Control de ingresos | FOUNDERS 2026": la solapa de
# clientes es «Seguimiento clientes», y las de pagos y asistencias van vacías
# porque esa planilla no las tiene. Una solapa vacía se saltea con un aviso,
# no con un error.
# OJO: si esta variable está seteada, manda sobre el nombre por defecto. Y si
# el nombre no existe, Google NO da error: devuelve la primera solapa del
# archivo. Dejala sin setear salvo que la solapa cambie de nombre.
# SHEETS_SOLAPA_CLIENTES=Seguimiento clientes

# La forma a prueba de balas de apuntar a una solapa: su gid, que no cambia si
# alguien la renombra. Es el número de #gid= en la URL cuando la tenés abierta.
# Si lo ponés, gana sobre el nombre.
# SHEETS_GID_CLIENTES=
# SHEETS_SOLAPA_PAGOS=
# SHEETS_SOLAPA_ASISTENCIAS=

# La planilla no tiene columna de moneda y sus importes están en dólares.
# SHEETS_MONEDA=USD

# --- Notion · Auditoría Clientes ------------------------------------------
# La segunda fuente, y la que decide qué consultor tiene cada cliente. Sin
# esto la app importa las cuotas pero nadie ve su cartera.
#
# NOTION_TOKEN: notion.so/profile/integrations → New integration (interna) →
# copiar el "Internal Integration Secret". Empieza con ntn_ o secret_.
# Después hay que darle acceso a la base: abrir «Auditoría Clientes» en
# Notion → ••• → Conexiones → agregar la integración. Sin ese paso la API
# responde 404 aunque el token sea correcto.
NOTION_TOKEN=

# El ID de la base: el bloque de 32 caracteres de su URL.
NOTION_DB_CLIENTES=3a3551416a9f80a09822dda28ca39ab0

# --- Drive · las transcripciones ------------------------------------------
# La tercera fuente: los documentos que deja Gemini en la carpeta de cada
# cliente. La carpeta la trae Notion, así que esto se corre después.
#
# El JSON completo de una cuenta de servicio de Google, pegado en una sola
# línea, tal cual lo descarga Google. Cómo se saca, en cinco pasos:
#
#   1. console.cloud.google.com → crear un proyecto (o usar el que haya).
#   2. APIs y servicios → Biblioteca → habilitar «Google Drive API».
#      Sin este paso el token se emite igual y después falla al leer.
#   3. IAM y administración → Cuentas de servicio → Crear cuenta de servicio.
#      No necesita ningún rol del proyecto: el permiso lo da Drive, no IAM.
#   4. En la cuenta creada → Claves → Agregar clave → Crear nueva → JSON.
#      Se descarga un archivo; su contenido entero va en esta variable.
#   5. En Drive, compartir la carpeta que contiene las carpetas de los
#      clientes con el email de la cuenta de servicio —el `client_email` del
#      JSON, termina en .iam.gserviceaccount.com—, como Lector. Se comparte
#      como se comparte con una persona. Sin esto Drive responde 404.
#
# El scope pedido es sólo lectura: la app no escribe en Drive.
GOOGLE_SERVICE_ACCOUNT_JSON=

# Cuántos clientes por corrida, para que un timeout no deje todo a medias.
# Por defecto 25: se aprieta el botón varias veces y cada corrida arranca por
# los clientes que menos documentos tienen. Lo ya traído no se vuelve a bajar.
# DRIVE_CLIENTES_POR_CORRIDA=25

# --- El extractor sobre toda la cartera -----------------------------------
# Cuántos clientes por corrida del barrido de fichas (`/planilla`, paso 4).
# Cada cliente es una llamada al modelo, y van en paralelo: subirlo acelera
# pero se acerca al tope de ejecución de la función. La pantalla vuelve a
# llamar sola hasta terminar, así que el número chico no cuesta clics.
# FICHA_CLIENTES_POR_CORRIDA=4
