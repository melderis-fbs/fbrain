# Copiar a .env.local y completar. Nada de esto es obligatorio para arrancar:
# sin ninguna variable Brain corre en modo demostración con 85 clientes
# ficticios, y sin la key de modelo los motores quedan "sin conectar" y
# responde el motor de reglas local.

# --- Base de datos ---------------------------------------------------------
# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Forzar el modo demostración aunque haya credenciales cargadas.
# Dejar vacío para usar Supabase. Valor admitido: demo
NEXT_PUBLIC_MODO_DATOS=

# --- Modelos ---------------------------------------------------------------
# NUNCA con prefijo NEXT_PUBLIC_: esta key no puede cruzar al browser.
ANTHROPIC_API_KEY=

# Opcionales. Por defecto los dos usan claude-opus-5.
# MODELO_CRITERIO   → diagnóstico, coherencia, onboarding, score y el chat
# MODELO_EXTRACCION → extractor de transcripciones y de ficha
MODELO_CRITERIO=
MODELO_EXTRACCION=

# Cuántas veces se le devuelve el error de validación al modelo antes de
# declarar el fallo. El contrato del paquete dice 3.
MAX_REINTENTOS_VALIDACION=3

# --- La planilla consolidada ----------------------------------------------
# El ID del enlace de Drive: el pedazo entre /d/ y /edit.
# La planilla tiene que estar compartida como "cualquiera con el enlace puede
# ver". No hace falta service account: se lee por el export CSV.
SHEETS_PLANILLA_ID=

# Nombres de las solapas, sólo si no usás los que vienen por defecto.
SHEETS_SOLAPA_CLIENTES=Clientes
SHEETS_SOLAPA_METRICAS=Metricas
SHEETS_SOLAPA_PAGOS=Pagos
SHEETS_SOLAPA_ASISTENCIAS=Asistencias
