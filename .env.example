# Copiar a .env.local y completar. Sin estas variables Brain arranca en modo
# demostración con los 85 clientes ficticios: no hace falta base de datos.

# Supabase (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Forzar el modo demostración aunque haya credenciales cargadas.
# Dejar vacío para usar Supabase. Valor admitido: demo
NEXT_PUBLIC_MODO_DATOS=
